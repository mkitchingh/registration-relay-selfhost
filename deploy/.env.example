# Copy to .env (cp .env.example .env) and fill in.

# 32 random bytes, base64. Generate once with:  openssl rand -base64 32
# BACK THIS UP. If it changes, every device gets a new code and has to re-register.
REGISTRATION_RELAY_SECRET=

# --- Public address: pick ONE ---
#   cloudflare  = Cloudflare Tunnel (recommended; needs a domain on Cloudflare)
#   tailscale   = Tailscale Funnel (free; no domain)
COMPOSE_PROFILES=cloudflare

# Option A, Cloudflare: Zero Trust -> Networks -> Tunnels -> Create tunnel -> copy the token (eyJ...).
# In that tunnel, add a Published application route:
#   relay.example.com  ->  HTTP  ->  rr-filter:8080
TUNNEL_TOKEN=

# Option B, Tailscale: admin console -> Settings -> Keys -> Generate auth key (tskey-auth-...).
# Only needed for the first start; the server stays signed in afterward.
TS_AUTHKEY=
# Becomes your address: https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=relay

# Local port the relay listens on (127.0.0.1 only). Change if 8080 is taken.
# RELAY_LOCAL_PORT=8080
